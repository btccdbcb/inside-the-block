# Analysis image: Python 3.11 and the locked dependencies of analysis/ (uv.lock). Profiles reproduce (default), verify
# and power of docker-compose.yml run it with the repository mounted read-only at /repo.
FROM ghcr.io/astral-sh/uv:0.13.6@sha256:af22a52f5eafef3d78e551599d405c02df61919d18028f0cea8eda93bc9986d0 AS uv
FROM python:3.11-slim-bookworm@sha256:94a8fee35252d06ab75856f15f12c7bae67b10e8a6da93c7fded82b2610926cd
COPY --from=uv /uv /usr/local/bin/uv
ENV UV_LINK_MODE=copy UV_PROJECT_ENVIRONMENT=/opt/venv UV_PYTHON_DOWNLOADS=never PYTHONDONTWRITEBYTECODE=1 \
    PATH=/opt/venv/bin:$PATH MPLCONFIGDIR=/tmp/mpl
WORKDIR /src/analysis
COPY analysis/pyproject.toml analysis/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
COPY analysis/ ./
RUN uv sync --frozen --no-dev
ENTRYPOINT ["itb-analysis"]
